<?xml version="1.0" encoding="utf-8"?>
<!-- The sample app keeps nothing worth restoring; exclude all data from cloud backup and from
     device-to-device transfer (Android 12+). android:allowBackup="false" covers older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
